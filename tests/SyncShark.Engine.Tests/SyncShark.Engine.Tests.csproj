<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <RootNamespace>Massdex.SyncShark.Engine.Tests</RootNamespace>
    <AssemblyName>SyncShark.Engine.Tests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\SyncShark.Engine\SyncShark.Engine.csproj" />
    <ProjectReference Include="..\..\src\SyncShark.Core\SyncShark.Core.csproj" />
    <!-- Test project only: the literals check parses C# (design section 10). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
    <!-- The scenario checks drive the real Dropbox side against the existing in-memory Dropbox account. -->
    <Compile Include="..\SyncShark.Core.Tests\V2\DropboxWire*.cs"
             Link="Scenarios\DropboxWire\%(Filename)%(Extension)" />
    <!-- The native Dropbox CLI route checks reuse the one scripted wire their Core owner already maintains. -->
    <Compile Include="..\SyncShark.Core.Tests\DropboxCli\DropboxRouteWire.cs"
             Link="Edge\DropboxRouteWire.cs" />
  </ItemGroup>
</Project>
