<Project>
  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">0.3.88</Version>
    <SyncSharkSourceRevision Condition="'$(SyncSharkSourceRevision)' == ''">UNBOUND</SyncSharkSourceRevision>
    <SyncSharkExpectedPreviousVersion Condition="'$(SyncSharkExpectedPreviousVersion)' == '' and '$(Configuration)' != 'Release'">0.3.47+19fb262ff6a943d5bf37b4ca003f07235e72515d</SyncSharkExpectedPreviousVersion>
    <InformationalVersion>$(Version)+$(SyncSharkSourceRevision)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>
  <!-- Inventory is opt-in; production warning policy and package graph stay unchanged. -->
  <PropertyGroup Condition="'$(SpecInventory)' == 'true'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ReportSuppressedDiagnostics>true</ReportSuppressedDiagnostics>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);SA1402;SA1649;CA1849;VSTHRD002;VSTHRD103;CA2016;CA1031;RCS1075;CS0419;CS1570;CS1573;CS1587;CS1591;CS1734</WarningsNotAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>8.0-none</AnalysisLevel>
    <NuGetLockFilePath>$(SpecInventoryOutput)/$(MSBuildProjectName).packages.lock.json</NuGetLockFilePath>
    <RestoreLockedMode>false</RestoreLockedMode>
    <ErrorLog>$(SpecInventoryOutput)/$(MSBuildProjectName).sarif,version=2.1</ErrorLog>
    <MetricsOutputFile>$(SpecInventoryOutput)/$(MSBuildProjectName).metrics.xml</MetricsOutputFile>
  </PropertyGroup>
  <ItemGroup Condition="'$(SpecInventory)' == 'true'">
    <GlobalAnalyzerConfigFiles Include="$(SpecInventoryOutput)/inventory.globalconfig" />
    <PackageReference Include="Microsoft.CodeAnalysis.Metrics" Version="4.14.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="8.0.0" PrivateAssets="all" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.12.19" PrivateAssets="all" />
    <PackageReference Include="Roslynator.Analyzers" Version="4.12.9" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyMetadata Include="SyncSharkSourceRevision" Value="$(SyncSharkSourceRevision)" />
  </ItemGroup>
  <Target Name="RequireBoundSyncSharkReleaseIdentity" BeforeTargets="CoreCompile"
          Condition="'$(Configuration)' == 'Release' and ('$(MSBuildProjectName)' == 'SyncShark' or '$(MSBuildProjectName)' == 'SyncShark.Core') and !$([System.Text.RegularExpressions.Regex]::IsMatch('$(SyncSharkSourceRevision)', '^[0-9a-f]{40}$'))">
    <Error Text="Release builds require SyncSharkSourceRevision to be the exact lowercase 40-character candidate commit." />
  </Target>
  <Target Name="RequireBoundSyncSharkReleasePredecessor" BeforeTargets="BuildSyncSharkDiscovery;BuildSyncSharkUpdater"
          Condition="'$(Configuration)' == 'Release'">
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(SyncSharkExpectedPreviousVersion)', '^\d+\.\d+\.\d+\+[0-9a-f]{40}$'))"
           Text="Release setup builds require an explicit SyncSharkExpectedPreviousVersion bound to the actual installed predecessor." />
  </Target>
  <PropertyGroup Condition="'$(SyncSharkBuildRoot)' != ''">
    <SyncSharkStableProjectName>$([System.Text.RegularExpressions.Regex]::Replace('$(MSBuildProjectName)', '_.*_wpftmp$', ''))</SyncSharkStableProjectName>
    <PathMap>$(SyncSharkBuildRoot)=/_syncshark_build</PathMap>
    <BaseOutputPath>$(SyncSharkBuildRoot)\bin\$(MSBuildProjectName)\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(SyncSharkBuildRoot)\obj\$(SyncSharkStableProjectName)\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(SyncSharkBuildRoot)\obj\$(SyncSharkStableProjectName)\</MSBuildProjectExtensionsPath>
    <RestorePackagesPath>$(SyncSharkBuildRoot)\packages</RestorePackagesPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**</DefaultItemExcludes>
  </PropertyGroup>
  <!-- SDK Clean can leave copied runtime dependencies after a framework-dependent publish.
       Limit this lifecycle cleanup to this app's registered external Release output shape;
       the separately staged package, Debug fixture and installed runtime are never targets. -->
  <Target Name="CleanSyncSharkReleaseDependencies" AfterTargets="Clean"
          Condition="'$(SyncSharkBuildRoot)' != '' and '$(Configuration)' == 'Release' and '$(MSBuildProjectName)' == 'SyncShark'">
    <PropertyGroup>
      <SyncSharkCleanPrefix>$([System.IO.Path]::GetFullPath('$(SyncSharkBuildRoot)\bin\SyncShark\Release\'))</SyncSharkCleanPrefix>
      <SyncSharkCleanTarget>$([System.IO.Path]::GetFullPath('$(TargetDir)'))</SyncSharkCleanTarget>
    </PropertyGroup>
    <Error Condition="!$([System.String]::Copy('$(SyncSharkCleanTarget)').StartsWith('$(SyncSharkCleanPrefix)', System.StringComparison.OrdinalIgnoreCase))"
           Text="Release dependency cleanup refused an output outside the owner build allocation." />
    <ItemGroup>
      <SyncSharkCleanDependency Include="$(SyncSharkCleanTarget)Microsoft.Windows.SDK.NET.dll;$(SyncSharkCleanTarget)WinRT.Runtime.dll;$(SyncSharkCleanTarget)Microsoft.Data.Sqlite.dll;$(SyncSharkCleanTarget)SQLitePCLRaw.*.dll;$(SyncSharkCleanTarget)e_sqlite3.dll;$(SyncSharkCleanTarget)SyncShark.Core.dll" />
    </ItemGroup>
    <Delete Files="@(SyncSharkCleanDependency)" />
  </Target>
</Project>
