{
  "commands": [
    {
      "command": "pairs list",
      "usage": "pairs list",
      "effect": "List the configured pairs.",
      "key": "PairsList",
      "options": []
    },
    {
      "command": "pairs add",
      "usage": "pairs add --name <name> --local <folder> --path <folder> --account <id> [--first-sync newest|pc|dropbox]",
      "effect": "Add a pair and select how its first comparison treats differences.",
      "key": "PairsAdd",
      "options": [
        "Account",
        "FirstSync",
        "Local",
        "Name",
        "Path"
      ]
    },
    {
      "command": "pairs remove",
      "usage": "pairs remove --pair <id>",
      "effect": "Remove the configuration, not the files. Report unfinished recovery before removal.",
      "key": "PairsRemove",
      "options": [
        "Pair"
      ]
    },
    {
      "command": "pairs bind",
      "usage": "pairs bind --pair <id> --yes",
      "effect": "Confirm the observed root identities for this pair.",
      "key": "PairsBind",
      "options": [
        "Pair",
        "Yes"
      ]
    },
    {
      "command": "pairs exclude",
      "usage": "pairs exclude --pair <id> --side local|dropbox --rel <path> [--keep] [--yes]",
      "effect": "Keep the selected copy out of sync. Without --keep, preview the removal and recovery information before confirming.",
      "key": "PairsExclude",
      "options": [
        "Keep",
        "Pair",
        "Rel",
        "Side",
        "Yes"
      ]
    },
    {
      "command": "pairs include",
      "usage": "pairs include --pair <id> --side local|dropbox --rel <path>",
      "effect": "Remove the exclusion and compare the newly included scope.",
      "key": "PairsInclude",
      "options": [
        "Pair",
        "Rel",
        "Side"
      ]
    },
    {
      "command": "pairs exclusions",
      "usage": "pairs exclusions --pair <id>",
      "effect": "List the configured exclusions.",
      "key": "PairsExclusions",
      "options": [
        "Pair"
      ]
    },
    {
      "command": "ignores list",
      "usage": "ignores list --pair <id>",
      "effect": "List the ignore rules.",
      "key": "IgnoresList",
      "options": [
        "Pair"
      ]
    },
    {
      "command": "ignores set",
      "usage": "ignores set --pair <id> --rules <rules>",
      "effect": "Replace this pair\u2019s ignore rules.",
      "key": "IgnoresSet",
      "options": [
        "Pair",
        "Rules"
      ]
    },
    {
      "command": "host start",
      "usage": "host start",
      "effect": "Start the background host or attach to the one already running.",
      "key": "HostStart",
      "options": []
    },
    {
      "command": "host stop",
      "usage": "host stop",
      "effect": "Stop the background host.",
      "key": "HostStop",
      "options": []
    },
    {
      "command": "status",
      "usage": "status [--pair <id>]",
      "effect": "Read current status without starting the host.",
      "key": "Status",
      "options": [
        "Pair"
      ]
    },
    {
      "command": "pause",
      "usage": "pause [--pair <id>]",
      "effect": "Pause one pair or all pairs until resume or restart.",
      "key": "Pause",
      "options": [
        "Pair"
      ]
    },
    {
      "command": "resume",
      "usage": "resume [--pair <id>]",
      "effect": "Resume one pair or all pairs.",
      "key": "Resume",
      "options": [
        "Pair"
      ]
    },
    {
      "command": "repair",
      "usage": "repair --pair <id>",
      "effect": "Compare both sides against the saved records.",
      "key": "Repair",
      "options": [
        "Pair"
      ]
    },
    {
      "command": "notices",
      "usage": "notices --pair <id> [--ignored]",
      "effect": "List current notices.",
      "key": "Notices",
      "options": [
        "Ignored",
        "Pair"
      ]
    },
    {
      "command": "resolve",
      "usage": "resolve --pair <id> --issue <number> --reviewed <token> --choice <choice> [--name <name>]",
      "effect": "Apply an available choice to the reviewed notice.",
      "key": "Resolve",
      "options": [
        "Choice",
        "Issue",
        "Name",
        "Pair",
        "Reviewed"
      ]
    },
    {
      "command": "logs",
      "usage": "logs --pair <id> --run <id> [--show-files]",
      "effect": "Read run logs, optionally including individual file operations.",
      "key": "Logs",
      "options": [
        "Pair",
        "Run",
        "ShowFiles"
      ]
    },
    {
      "command": "accounts connect",
      "usage": "accounts connect",
      "effect": "Connect a Dropbox account through browser sign-in.",
      "key": "AccountsConnect",
      "options": []
    },
    {
      "command": "accounts disconnect",
      "usage": "accounts disconnect --account <id>",
      "effect": "Disconnect the account and pause affected pairs without deleting files.",
      "key": "AccountsDisconnect",
      "options": [
        "Account"
      ]
    }
  ],
