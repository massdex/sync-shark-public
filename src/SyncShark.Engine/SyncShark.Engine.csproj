<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <RootNamespace>Massdex.SyncShark.Engine</RootNamespace>
    <AssemblyName>SyncShark.Engine</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SyncShark.Core\SyncShark.Core.csproj" />
    <EmbeddedResource Include="engine-path-case.json" LogicalName="SyncShark.EnginePathCase.json" />
    <EmbeddedResource Include="engine-settings.json" LogicalName="SyncShark.EngineSettings.json" />
    <EmbeddedResource Include="engine-strings.json" LogicalName="SyncShark.EngineStrings.json" />
    <InternalsVisibleTo Include="SyncShark.Engine.Tests" />
    <InternalsVisibleTo Include="SyncShark" />
  </ItemGroup>
</Project>
