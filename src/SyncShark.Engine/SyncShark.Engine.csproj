<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <RootNamespace>Massdex.SyncShark.Engine</RootNamespace>
    <AssemblyName>SyncShark.Engine</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.11" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <EmbeddedResource Include="../../tools/SyncShark.SignerIdentity.json" LogicalName="SyncShark.SignerIdentity.json" />
    <EmbeddedResource Include="engine-path-case.json" LogicalName="SyncShark.EnginePathCase.json" />
    <EmbeddedResource Include="engine-settings.json" LogicalName="SyncShark.EngineSettings.json" />
    <EmbeddedResource Include="engine-strings.json" LogicalName="SyncShark.EngineStrings.json" />
    <EmbeddedResource Include="Dropbox/dropbox-routes.json" LogicalName="SyncShark.DropboxRoutes.json" />
    <EmbeddedResource Include="Edge/engine-cli.json" LogicalName="SyncShark.EngineCli.json" />
  </ItemGroup>
</Project>
