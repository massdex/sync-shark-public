# Only synthetic fixtures opt in here. The collector copies these settings into
# an inventory-only global analyzer config; normal builds retain their policy.
[tools/ci/fixtures/spec-inventory/cases/**/*.cs]
dotnet_analyzer_diagnostic.severity = none
dotnet_diagnostic.SA1402.severity = warning
dotnet_diagnostic.SA1649.severity = warning
dotnet_diagnostic.CA1849.severity = warning
dotnet_diagnostic.VSTHRD002.severity = warning
dotnet_diagnostic.VSTHRD103.severity = warning
dotnet_diagnostic.CA2016.severity = warning
dotnet_diagnostic.CA1031.severity = warning
dotnet_diagnostic.RCS1075.severity = warning
dotnet_diagnostic.CS1591.severity = warning
