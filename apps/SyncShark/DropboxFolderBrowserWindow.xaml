<Window x:Class="Massdex.SyncShark.DropboxFolderBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Massdex.SyncShark"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Browse Dropbox folders" Width="760" Height="650" MinWidth="620" MinHeight="520"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource Canvas}">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
  </shell:WindowChrome.WindowChrome>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="52" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
      <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Right" Style="{StaticResource CaptionButton}" Content="✕" ToolTip="Close" Click="Cancel_Click"
                shell:WindowChrome.IsHitTestVisibleInChrome="True" />
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
          <Image Source="Assets/SyncShark-64.png" Width="28" Height="28" Margin="0,0,10,0" />
          <StackPanel><TextBlock Text="{Binding BrowserTitle}" FontSize="17" FontWeight="SemiBold" /><TextBlock x:Name="AccountText" FontSize="12" Foreground="{DynamicResource MutedInk}" TextTrimming="CharacterEllipsis" ToolTip="The exact provider connection used by this folder browser" AutomationProperties.Name="Cloud folder browser account" /></StackPanel>
        </StackPanel>
      </DockPanel>
    </Border>

    <Border Grid.Row="1" Margin="16,16,16,10" Padding="12,9" CornerRadius="7" Background="{DynamicResource RaisedSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="LoadMoreButton" Content="Load more" Click="LoadMore_Click" Visibility="Collapsed" ToolTip="Load the next Dropbox folder page for the selected location or search." />
          <Button x:Name="RefreshButton" Content="Refresh" Click="Refresh_Click" ToolTip="Reload the selected folder" />
        </StackPanel>
        <TextBox x:Name="FolderSearchBox" DockPanel.Dock="Right" Width="220" Margin="8,0" TextChanged="FolderSearch_Changed" ToolTip="Search folders in the connected Dropbox without first loading the whole hierarchy." AutomationProperties.Name="Search Dropbox folders" />
        <TextBlock x:Name="BreadcrumbText" Text="Dropbox /" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.Name="Selected Dropbox breadcrumb" />
      </DockPanel>
    </Border>

    <Grid Grid.Row="2" Margin="16,0">
      <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Border Grid.Row="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="4">
        <TreeView x:Name="FolderTree" ItemsSource="{Binding Roots}" SelectedItemChanged="FolderTree_SelectedItemChanged" PreviewMouseRightButtonDown="FolderTree_PreviewMouseRightButtonDown"
                  TreeViewItem.Expanded="FolderTree_Expanded" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  AutomationProperties.Name="Dropbox folders">
          <TreeView.Resources>
            <HierarchicalDataTemplate DataType="{x:Type local:DropboxFolderNode}" ItemsSource="{Binding Children}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="▸" Foreground="{DynamicResource DropboxBlue}" Margin="0,0,7,0" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
              </Grid>
            </HierarchicalDataTemplate>
            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}"><Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=OneWay}" /></Style>
          </TreeView.Resources>
          <TreeView.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Refresh folder" Click="Refresh_Click" />
              <MenuItem x:Name="CreateFolderContextMenuItem" Header="Create folder here" Click="FocusCreateFolder_Click" />
              <Separator />
              <MenuItem Header="Select this folder" Click="Select_Click" />
            </ContextMenu>
          </TreeView.ContextMenu>
        </TreeView>
      </Border>
      <TextBlock x:Name="BrowserStatus" Grid.Row="1" Margin="2,9,2,0" Foreground="{DynamicResource MutedInk}" Text="Loading Dropbox folders…" TextWrapping="Wrap" />
      <Grid x:Name="CreateFolderPanel" Grid.Row="2" Margin="0,12,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBox x:Name="NewFolderName" Grid.Column="0" Margin="0,0,8,0" ToolTip="Name for a new child folder" AutomationProperties.Name="New Dropbox folder name" />
        <Button x:Name="CreateFolderButton" Grid.Column="1" Content="Create folder" Click="CreateFolder_Click" AutomationProperties.Name="Create Dropbox folder in selected folder" />
      </Grid>
    </Grid>

    <Border Grid.Row="3" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="16,12" Margin="0,16,0,0">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="{DynamicResource MutedInk}" Text="The folder ID is retained; the path alone is never trusted." TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Content="Cancel" Click="Cancel_Click" IsCancel="True" />
          <Button x:Name="SelectFolderButton" Style="{StaticResource PrimaryButton}" Content="Select folder" Click="Select_Click" IsEnabled="False" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
