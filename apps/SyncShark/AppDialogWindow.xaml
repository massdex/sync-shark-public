<Window x:Class="Massdex.SyncShark.AppDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sync Shark" Width="560" SizeToContent="Height" MaxHeight="720"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{DynamicResource Canvas}">
  <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10"
          Background="{DynamicResource Surface}">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="52" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Border Background="{DynamicResource RaisedSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" CornerRadius="10,10,0,0">
        <Grid Margin="18,0,8,0">
          <TextBlock x:Name="DialogTitle" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button HorizontalAlignment="Right" Width="36" Height="34" MinHeight="34" Padding="0" Margin="0"
                  Content="✕" Click="Cancel_Click" AutomationProperties.Name="Close dialog" />
        </Grid>
      </Border>
      <ScrollViewer Grid.Row="1" MaxHeight="530" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22,20">
          <TextBlock x:Name="DialogSummary" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock x:Name="DialogDetail" Margin="0,10,0,0" Foreground="{DynamicResource MutedInk}"
                     TextWrapping="Wrap" LineHeight="21" />
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="2" Background="{DynamicResource RaisedSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" CornerRadius="0,0,10,10">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,14">
          <Button x:Name="TertiaryButton" Content="Cancel" Click="Tertiary_Click" Visibility="Collapsed" />
          <Button x:Name="SecondaryButton" Content="Cancel" Click="Secondary_Click" IsCancel="True" />
          <Button x:Name="PrimaryButton" Style="{StaticResource PrimaryButton}" Content="Continue" Click="Primary_Click" IsDefault="True" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
