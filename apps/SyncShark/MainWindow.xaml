                            </StackPanel>
                            <Border x:Name="PairPreviewUnavailable" Grid.Row="2" Visibility="Collapsed" Background="{DynamicResource RaisedSurface}" BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="1" CornerRadius="7" Padding="14" Margin="0,0,0,12">
                              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Preview Unavailable" FontWeight="SemiBold" /><TextBlock x:Name="PairPreviewUnavailableReason" Text="Repair this pair before loading its sync preview." Foreground="{DynamicResource MutedInk}" Margin="0,4,12,0" TextWrapping="Wrap" /></StackPanel>
                                <Button Grid.Column="1" Content="Repair folders" Click="ChangePairRoots_Click" VerticalAlignment="Center" />
                              </Grid>
                            </Border>
                            <DataGrid x:Name="PairPreviewGrid" Grid.Row="3" ItemsSource="{Binding PairPreviewRows}" AutoGenerateColumns="False" MinHeight="190">
