              </ComboBox>
              <ComboBox x:Name="BootstrapTypeFilter" Width="120" IsEditable="True" SelectionChanged="BootstrapFilter_Changed" LostKeyboardFocus="BootstrapTypeFilter_LostKeyboardFocus" ToolTip="Filter by Folder, File, or an extension such as PDF or DOCX.">
                <ComboBoxItem Content="All types" IsSelected="True" /><ComboBoxItem Content="Folder" /><ComboBoxItem Content="File" /><ComboBoxItem Content="PDF" /><ComboBoxItem Content="DOCX" /><ComboBoxItem Content="XLSX" /><ComboBoxItem Content="JPG" /><ComboBoxItem Content="PNG" /><ComboBoxItem Content="TXT" />
              </ComboBox>
              <Button x:Name="LoadMoreBootstrapButton" Content="Load more" Click="LoadMoreBootstrap_Click" />
            </WrapPanel>
          </Grid>
          <DataGrid x:Name="BootstrapGrid" Grid.Row="2" ItemsSource="{Binding BootstrapRows}" AutoGenerateColumns="False" SelectionMode="Extended" HorizontalScrollBarVisibility="Visible" EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="First sync inventory">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Pair" Binding="{Binding PairName}" Width="130" MinWidth="120" />
              <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="2*" MinWidth="180" />
              <DataGridTemplateColumn Header="Action" Width="1.15*" MinWidth="130">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <ComboBox ItemsSource="{Binding ActionChoices}" DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding SelectedAction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanChooseAction}" Margin="0" Padding="5,3" AutomationProperties.Name="First sync action" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="What will happen" Binding="{Binding Effect}" Width="1.4*" MinWidth="165" />
              <DataGridTextColumn Header="Item" Binding="{Binding ItemKind}" Width="80" MinWidth="72" />
              <DataGridTextColumn Header="Type" Binding="{Binding FileType}" Width="75" MinWidth="70" />
              <DataGridTextColumn Header="Where it is now" Binding="{Binding DisplayGroup}" Width="1.2*" MinWidth="125" />
              <DataGridTextColumn Header="Left size" Binding="{Binding LeftSize}" Width="90" MinWidth="85" />
              <DataGridTextColumn Header="Right size" Binding="{Binding RightSize}" Width="100" MinWidth="95" />
              <DataGridTextColumn Header="Left modified" Binding="{Binding LeftModified}" Width="150" MinWidth="140" />
              <DataGridTextColumn Header="Right modified" Binding="{Binding RightModified}" Width="155" MinWidth="145" />
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock x:Name="BootstrapChoiceSummary" Grid.Row="3" Margin="0,8,0,0" Foreground="{DynamicResource MutedInk}" Text="Recommended actions are selected. Skip for now leaves an item unchanged and waiting here." TextWrapping="Wrap" />
        </Grid>
      </Border>

      <Border x:Name="ActivityPage" Visibility="Collapsed">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <StackPanel Margin="0,0,0,10"><TextBlock Text="Activity" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="Every sync check, transfer, move, conflict and recovery action—live and retained after restart." Foreground="{DynamicResource MutedInk}" Margin="0,4,0,0" TextWrapping="Wrap" /></StackPanel>
          <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock x:Name="ActivityPageSummary" Text="Newest retained events" Foreground="{DynamicResource MutedInk}" Margin="0,0,0,7" />
            <WrapPanel>
              <Button Content="Open queue" Click="OpenQueue_Click" /><Button Content="Review conflicts" Click="OpenConflicts_Click" />
              <ComboBox x:Name="ActivityPairBox" Width="180" ItemsSource="{Binding ActivityPairChoices}" DisplayMemberPath="DisplayName" SelectionChanged="ActivityFilter_Changed" AutomationProperties.Name="Filter activity by folder pair" />
              <Grid Width="220"><TextBox x:Name="ActivitySearchBox" Padding="31,7,9,7" TextChanged="ActivityFilter_Changed" ToolTip="Search by pair, path, action, explanation or run ID." AutomationProperties.Name="Search activity" /><TextBlock Text="⌕" FontSize="18" Foreground="{DynamicResource MutedInk}" Margin="10,0,0,1" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" /><TextBlock Text="Search activity…" Foreground="{DynamicResource MutedInk}" Margin="31,0,8,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=ActivitySearchBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
              <ComboBox x:Name="ActivityFilterBox" Width="165" SelectionChanged="ActivityFilter_Changed"><ComboBoxItem Content="All actions" IsSelected="True" /><ComboBoxItem Content="Uploads / downloads" Tag="Transfers" /><ComboBoxItem Content="Moves" /><ComboBoxItem Content="Conflicts" /><ComboBoxItem Content="Recovery / deletions" /><ComboBoxItem Content="Needs attention" /></ComboBox>
              <ComboBox x:Name="ActivityTypeFilter" Width="120" IsEditable="True" Text="All types" SelectionChanged="ActivityFilter_Changed" LostKeyboardFocus="ActivityTypeFilter_LostKeyboardFocus" ToolTip="Show folders, files, or one file type such as PDF or DOCX." AutomationProperties.Name="Filter activity by item type"><ComboBoxItem Content="All types" IsSelected="True" /><ComboBoxItem Content="Folders" /><ComboBoxItem Content="Files" /></ComboBox>
              <ComboBox x:Name="ActivityDateBox" Width="120" SelectionChanged="ActivityFilter_Changed" AutomationProperties.Name="Filter activity by date"><ComboBoxItem Content="All time" IsSelected="True" /><ComboBoxItem Content="Today" /><ComboBoxItem Content="Last 7 days" /><ComboBoxItem Content="Last 30 days" /></ComboBox>
              <Button x:Name="LoadMoreActivityButton" Content="Load more" Click="LoadMoreActivity_Click" />
            </WrapPanel>
          </StackPanel>
          <DataGrid x:Name="ActivityGrid" Grid.Row="2" ItemsSource="{Binding ActivityRows}" AutoGenerateColumns="False" MinColumnWidth="70" EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" PreviewMouseRightButtonDown="ActivityGrid_PreviewMouseRightButtonDown" AutomationProperties.Name="Durable sync activity"><DataGrid.ContextMenu><ContextMenu Opened="ActivityContextMenu_Opening"><MenuItem x:Name="ActivityOpenPairMenuItem" Header="Open folder pair" Click="OpenActivityPair_Click" /><MenuItem x:Name="ActivityOpenRecoveryMenuItem" Header="Open Recovery" Click="OpenActivityRecovery_Click" /><Separator /><MenuItem x:Name="ActivityCopyPathMenuItem" Header="Copy path" Click="CopyActivityPath_Click" /><MenuItem x:Name="ActivityCopyDetailsMenuItem" Header="Copy details" Click="CopyActivityDetails_Click" /></ContextMenu></DataGrid.ContextMenu><DataGrid.Columns><DataGridTextColumn Header="When" Binding="{Binding When}" Width="170" /><DataGridTextColumn Header="Pair" Binding="{Binding PairName}" Width="145" /><DataGridTextColumn Header="Item" Binding="{Binding ItemKind}" Width="75" /><DataGridTextColumn Header="Type" Binding="{Binding FileType}" Width="85" /><DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*" MinWidth="160" /><DataGridTextColumn Header="Action" Binding="{Binding Outcome}" Width="145" /><DataGridTextColumn Header="Details" Binding="{Binding Reason}" Width="2*" MinWidth="220" /></DataGrid.Columns></DataGrid>
        </Grid>
      </Border>
      <Border x:Name="QueuePage" Visibility="Collapsed"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><StackPanel Margin="0,0,0,10"><TextBlock Text="Pending work" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="Transfers and recovery work that Sync Shark still needs to finish. Interrupted work stays here after restart so it can continue safely." Foreground="{DynamicResource MutedInk}" Margin="0,4,0,0" TextWrapping="Wrap" /></StackPanel><Grid Grid.Row="1" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="QueuePageSummary" Text="Current pending work" Foreground="{DynamicResource MutedInk}" VerticalAlignment="Center" /><WrapPanel Grid.Column="1"><TextBox x:Name="QueueSearchBox" Width="190" TextChanged="QueueFilter_Changed" ToolTip="Search pending work by pair, path, action or status." AutomationProperties.Name="Search pending work" /><ComboBox x:Name="QueueFilterBox" Width="150" SelectionChanged="QueueFilter_Changed"><ComboBoxItem Content="All" IsSelected="True" /><ComboBoxItem Content="Needs recovery" /><ComboBoxItem Content="Blocked" /><ComboBoxItem Content="Uploads / downloads" Tag="Transfers" /><ComboBoxItem Content="Moves" /></ComboBox><Button x:Name="LoadMoreQueueButton" Content="Load more" Click="LoadMoreQueue_Click" /></WrapPanel></Grid><DataGrid Grid.Row="2" ItemsSource="{Binding QueueRows}" AutoGenerateColumns="False" EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Pending sync work"><DataGrid.Columns><DataGridTextColumn Header="Added" Binding="{Binding Enqueued}" Width="180" /><DataGridTextColumn Header="Connection" Binding="{Binding Connection}" Width="190" /><DataGridTextColumn Header="Pair" Binding="{Binding Pair}" Width="170" /><DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*" /><DataGridTextColumn Header="Sync Order" Binding="{Binding Priority}" Width="90" /><DataGridTextColumn Header="Action" Binding="{Binding Operation}" Width="130" /><DataGridTextColumn Header="Status" Binding="{Binding State}" Width="190" /></DataGrid.Columns></DataGrid></Grid></Border>
      <Border x:Name="ConflictsPage" Visibility="Collapsed">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Conflicts" FontSize="24" FontWeight="SemiBold" />
            <Expander x:Name="ConflictGuidanceExpander" Header="How to Resolve Conflicts" FontSize="12" Margin="0,4,0,0">
              <TextBlock Text="Compare both versions, then choose what to keep for selected items or every conflict matching the current filters. Modified times help form a recommendation, but Sync Shark never chooses for you." Foreground="{DynamicResource MutedInk}" Margin="0,6,0,0" TextWrapping="Wrap" />
            </Expander>
            <TextBlock x:Name="ConflictSelectionSummary" Text="No all-matching selection is active." Foreground="{DynamicResource MutedInk}" Margin="0,5,0,0" TextWrapping="Wrap">
              <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="No all-matching selection is active."><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
              </Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
          </StackPanel>
          <TextBlock x:Name="ConflictActionFeedback" Visibility="Collapsed" Foreground="{DynamicResource MutedInk}" Margin="0,0,0,10" TextWrapping="Wrap" AutomationProperties.Name="Action status" />
          <WrapPanel Grid.Row="1" Margin="0,0,0,12">
            <ComboBox x:Name="ConflictGroupFilter" Width="185" SelectionChanged="ConflictFilter_Changed" ToolTip="Group conflicts by which version was modified more recently">
              <ComboBoxItem Content="All groups" IsSelected="True" /><ComboBoxItem Content="Newer version" Tag="Newer version" /><ComboBoxItem Content="Approximately equal time" /><ComboBoxItem Content="Unreliable or missing time" />
            </ComboBox>
            <TextBox x:Name="ConflictSearchBox" Width="190" TextChanged="ConflictFilter_Changed" ToolTip="Filter conflict paths" AutomationProperties.Name="Filter conflicts" />
            <Button x:Name="LoadMoreConflictsButton" Content="Load more" Click="LoadMoreConflicts_Click" />
            <Expander Header="Bulk Actions" Margin="4,6,0,0" FontSize="12">
              <WrapPanel Margin="0,8,0,0">
                <Button x:Name="KeepLocalConflictButton" Style="{StaticResource PrimaryButton}" Content="Use left" Click="ResolveKeepLocal_Click" AutomationProperties.Name="Use the left endpoint's version for the selected conflicts. The right endpoint's version is retained in Recovery first." />
                <Button x:Name="KeepDropboxConflictButton" Content="Use right" Click="ResolveKeepDropbox_Click" AutomationProperties.Name="Use the right endpoint's version for the selected conflicts. The left endpoint's version is retained in Recovery first." />
                <Button x:Name="PreserveBothConflictButton" Content="Keep both" Click="ResolvePreserveBoth_Click" AutomationProperties.Name="Keep both versions for selected conflicts" />
                <Button x:Name="SelectAllMatchingConflictsButton" Content="Select all matching" Click="SelectAllConflicts_Click" ToolTip="Target every conflict matching this pair, group and search, including rows not loaded on screen." />
              </WrapPanel>
            </Expander>
          </WrapPanel>
          <DataGrid x:Name="ConflictGrid" Grid.Row="2" ItemsSource="{Binding ConflictRows}" AutoGenerateColumns="False" HorizontalScrollBarVisibility="Visible" EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" SelectionMode="Extended" SelectionChanged="ConflictGrid_SelectionChanged" PreviewMouseRightButtonDown="ConflictGrid_PreviewMouseRightButtonDown" MouseDoubleClick="CompareConflict_Click" AutomationProperties.Name="Pair-bound conflicts">
            <DataGrid.ContextMenu><ContextMenu><MenuItem Header="Compare…" Click="CompareConflict_Click" /><Separator /><MenuItem Header="Use left" Tag="keep-left" Click="ResolveKeepLocal_Click" AutomationProperties.Name="Use the left endpoint's version for the selected conflicts. The right endpoint's version is retained in Recovery first." /><MenuItem Header="Use right" Tag="keep-right" Click="ResolveKeepDropbox_Click" AutomationProperties.Name="Use the right endpoint's version for the selected conflicts. The left endpoint's version is retained in Recovery first." /><MenuItem Header="Keep both" Click="ResolvePreserveBoth_Click" AutomationProperties.Name="Keep both conflict versions" /></ContextMenu></DataGrid.ContextMenu>
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="Options" Width="Auto">
                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                  <ItemsControl ItemsSource="{Binding NoticeOptions}" Tag="{Binding}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate>
                      <Button Content="{Binding Label}" Tag="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              Click="NoticeOption_Click" ToolTip="Apply the selected notice action. 'Use the other version' replaces the current file and keeps the replaced version recoverable (local Recovery or Dropbox version history); 'Save the other version as a copy' adds a separate file; 'Dismiss' changes no files." />
                    </DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                </DataTemplate></DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Connection" Binding="{Binding Connection}" Width="130" />
              <DataGridTextColumn Header="Pair" Binding="{Binding PairName}" Width="110" />
              <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*" MinWidth="160" />
              <DataGridTextColumn Header="Comparison" Binding="{Binding GroupDisplay}" Width="135" />
              <DataGridTextColumn Header="Recommendation" Binding="{Binding Recommendation}" Width="115" />
              <DataGridTextColumn Header="Left modified" Binding="{Binding LocalModified}" Width="140" />
              <DataGridTextColumn Header="Right modified" Binding="{Binding DropboxModified}" Width="145" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>

      <Border x:Name="RecoveryPage" Visibility="Collapsed">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Recovery" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Browse protected recovery copies, revisions and deleted items supported by the selected pair. Replacements preview and retain the current destination first." Foreground="{DynamicResource MutedInk}" Margin="0,4,0,0" TextWrapping="Wrap" />
            <TextBlock x:Name="RecoverySummary" Text="Choose a pair to load its retained recovery records." Margin="0,8,0,0" TextWrapping="Wrap" />
          </StackPanel>
          <WrapPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Pair" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="RecoveryPairBox" Width="230" ItemsSource="{Binding RecoveryPairChoices}" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectionChanged="RecoveryPair_SelectionChanged" AutomationProperties.Name="Recovery pair" />
            <Button Content="Refresh archives + deleted" Click="RefreshRecovery_Click" ToolTip="Refresh retained Sync Shark archives and available deleted-item metadata for this pair's provider." />
            <Button Content="Dropbox Rewind" Click="OpenRewind_Click" ToolTip="Open the guided Dropbox Rewind workflow for a whole-folder rollback." />
            <StackPanel Orientation="Horizontal">
              <TextBox x:Name="RecoverySearchBox" Width="180" TextChanged="RecoveryFilter_Changed" ToolTip="Filter the recovery items already loaded; no provider refresh." AutomationProperties.Name="Filter recovery items" />
              <TextBox x:Name="RecoveryPathBox" Width="260" ToolTip="Enter a path from this pair to load its provider's retained revision history." AutomationProperties.Name="Revision path" />
              <Button Content="Load revisions" Click="LoadRecoveryRevisions_Click" ToolTip="Load this path's retained revision history from its own provider." />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="RestoreOriginalButton" Style="{StaticResource PrimaryButton}" Content="Restore original" Click="RestoreOriginal_Click" ToolTip="Preview, retain any occupied destination, then restore to the original path." />
              <Button x:Name="RestoreCopyButton" Content="Restore as copy" Click="RestoreCopy_Click" ToolTip="Preview and restore to a new collision-free path without replacing the current destination." />
              <Button x:Name="RemoveRecoveryButton" Content="Remove selected copy…" Click="RemoveRecovery_Click" IsEnabled="False" ToolTip="Permanently removes the selected Sync Shark Recovery copy after a separate warning. Activity history is kept." />
            </StackPanel>
          </WrapPanel>
          <DataGrid x:Name="RecoveryGrid" Grid.Row="2" ItemsSource="{Binding RecoveryRows}" AutoGenerateColumns="False" HorizontalScrollBarVisibility="Visible" EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling" SelectionMode="Single" SelectionChanged="RecoveryGrid_SelectionChanged" AutomationProperties.Name="Recovery browser">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Connection" Binding="{Binding Connection}" Width="140" />
              <DataGridTextColumn Header="Pair" Binding="{Binding PairName}" Width="100" />
              <DataGridTextColumn Header="Type" Binding="{Binding Source}" Width="110" />
              <DataGridTextColumn Header="Original path" Binding="{Binding Path}" Width="1.5*" MinWidth="180" />
              <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="*" MinWidth="150" />
              <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="80" />
              <DataGridTextColumn Header="Retained" Binding="{Binding Retained}" Width="150" />
              <DataGridTextColumn Header="Retention" Binding="{Binding Retention}" Width="160" />
              <DataGridTextColumn Header="Health" Binding="{Binding Health}" Width="180" />
            </DataGrid.Columns>
          </DataGrid>
          <Grid Grid.Row="3" Margin="2,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="RecoveryDetails" Foreground="{DynamicResource MutedInk}" Text="No recovery item selected." TextWrapping="Wrap" />
            <Button x:Name="LoadMoreRecoveryButton" Grid.Column="1" Content="Load more" Click="LoadMoreRecovery_Click" Visibility="Collapsed" ToolTip="Load the next bounded page of protected archives and Dropbox deleted-item metadata." />
          </Grid>
        </Grid>
      </Border>

      <Border x:Name="RewindPage" Visibility="Collapsed">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Dropbox Rewind" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Coordinate an intentional Dropbox rollback without allowing ordinary local uploads to reverse it. Sync Shark checkpoints and pauses the selected pair before opening Dropbox." Foreground="{DynamicResource MutedInk}" Margin="0,4,0,0" TextWrapping="Wrap" />
          </StackPanel>
          <Border Grid.Row="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,0,0,12">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <TextBlock Text="Affected Pair" VerticalAlignment="Center" /><ComboBox x:Name="RewindPairBox" Grid.Column="1" ItemsSource="{Binding PairRows}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="RewindPair_SelectionChanged" AutomationProperties.Name="Dropbox Rewind pair" />
              <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="PrepareRewindButton" Style="{StaticResource PrimaryButton}" Content="Checkpoint + open Dropbox" Click="PrepareRewind_Click" ToolTip="Create complete local and Dropbox checkpoints, pause this pair, then open its folder on dropbox.com." /><Button Content="Open Dropbox folder" Click="OpenDropboxRewind_Click" ToolTip="Open the selected pair folder; choose Folder settings, then Rewind this folder." /></StackPanel>
              <TextBlock Grid.Row="1" Text="Expected Account" Margin="0,10,0,0" /><TextBlock x:Name="RewindAccountText" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="No connected account" Margin="0,10,0,0" />
              <TextBlock Grid.Row="2" Text="Dropbox Folder" Margin="0,10,0,0" /><TextBlock x:Name="RewindPathText" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="—" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" />
            </Grid>
          </Border>
          <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="RewindStatusText" Text="Prepare a checkpoint before using Rewind on dropbox.com." VerticalAlignment="Center" TextWrapping="Wrap" />
            <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="DetectRewindButton" Content="Detect + preview rollback" Click="DetectRewind_Click" ToolTip="After Dropbox confirms Rewind is complete, inventory both sides and preview the intentional rollback batch without local effects." /><Button x:Name="ApplyRewindButton" Style="{StaticResource PrimaryButton}" Content="Apply preview" Click="ApplyRewind_Click" IsEnabled="False" ToolTip="Apply only the exact reviewed paths. Every path and provider-effect boundary is durably checkpointed; post-checkpoint local work becomes a conflict." /><Button x:Name="ResumeRewindButton" Content="Resume normal sync" Click="ResumeRewind_Click" IsEnabled="False" ToolTip="Resume only after the reviewed batch is provably complete. Before apply, cancellation requires a live check that Dropbox still matches the checkpoint." /></StackPanel>
          </Grid>
          <DataGrid x:Name="RewindGrid" Grid.Row="3" ItemsSource="{Binding RewindRows}" AutoGenerateColumns="False" HorizontalScrollBarVisibility="Visible" EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Dropbox Rewind effect preview">
            <DataGrid.Columns><DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*" /><DataGridTextColumn Header="State" Binding="{Binding Status}" Width="130" /><DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="210" /><DataGridTextColumn Header="Proposed Local Effect" Binding="{Binding Effect}" Width="260" /><DataGridTextColumn Header="Post-Checkpoint Local Change" Binding="{Binding LocalChanged}" Width="180" /><DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="2*" /></DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>

      <Border x:Name="ConnectionsPage" Visibility="Collapsed">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel HorizontalAlignment="Stretch">
            <TextBlock Text="Connections" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Accounts are retained as stable provider connections so future Dropbox accounts and storage providers can be added without rebinding this interface." Foreground="{DynamicResource MutedInk}" Margin="0,4,0,16" TextWrapping="Wrap" />
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="9" Padding="18">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Grid.ColumnSpan="2" Text="{Binding ProviderPresentation.Name, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,16" />
                <TextBlock Grid.Row="1" Text="Provider" /><TextBlock x:Name="ConnectionProviderText" Grid.Row="1" Grid.Column="1" Text="Dropbox" FontWeight="SemiBold" />
                <TextBlock Grid.Row="2" Text="Account" Margin="0,9,0,0" /><TextBlock x:Name="ConnectionNameText" Grid.Row="2" Grid.Column="1" Text="Checking account…" FontWeight="SemiBold" Margin="0,9,0,0" />
                <TextBlock Grid.Row="3" Text="Email" Margin="0,9,0,0" /><TextBlock x:Name="ConnectionEmailText" Grid.Row="3" Grid.Column="1" Text="—" Margin="0,9,0,0" />
                <TextBlock Grid.Row="4" Text="Plan" Margin="0,9,0,0" /><TextBlock x:Name="ConnectionTypeText" Grid.Row="4" Grid.Column="1" Text="—" Margin="0,9,0,0" />
                <TextBlock Grid.Row="5" Text="Access" Margin="0,9,0,0" /><TextBlock x:Name="ConnectionAccessText" Grid.Row="5" Grid.Column="1" Text="Full Dropbox" Margin="0,9,0,0" />
                <TextBlock Grid.Row="6" Text="Health" Margin="0,9,0,0" /><TextBlock x:Name="ConnectionHealthText" Grid.Row="6" Grid.Column="1" Text="Checking connection…" Margin="0,9,0,0" />
                <TextBlock Grid.Row="7" Text="Last verified" Margin="0,9,0,0" /><TextBlock x:Name="ConnectionVerifiedText" Grid.Row="7" Grid.Column="1" Text="—" Margin="0,9,0,0" />
                <TextBlock Grid.Row="8" Text="Last successful sync" Margin="0,9,0,0" /><TextBlock x:Name="ConnectionLastSyncText" Grid.Row="8" Grid.Column="1" Text="—" Margin="0,9,0,0" />
                <TextBlock Grid.Row="9" Text="Dependent pairs" Margin="0,9,0,0" /><TextBlock x:Name="ConnectionPairsText" Grid.Row="9" Grid.Column="1" Text="0" Margin="0,9,0,0" />
                <TextBlock Grid.Row="10" Text="Connection ID" Margin="0,9,0,0" /><TextBlock x:Name="ConnectionIdText" Grid.Row="10" Grid.Column="1" Text="—" Foreground="{DynamicResource MutedInk}" TextTrimming="CharacterEllipsis" Margin="0,9,0,0" />
                <StackPanel Grid.Row="11" Grid.Column="1" Orientation="Horizontal" Margin="0,18,0,0">
                  <Button x:Name="ConnectionConnectButton" Style="{StaticResource PrimaryButton}" Content="Connect Dropbox" Click="Connect_Click" IsEnabled="False" Visibility="Collapsed" />
                  <Button x:Name="ConnectionReauthorizeButton" Content="Reconnect" Click="Reconnect_Click" IsEnabled="False" ToolTip="Renew authorization for this exact Dropbox application and account connection." />
                  <Button x:Name="ConnectionManageButton" Content="Manage on Dropbox" Click="ManageDropbox_Click" IsEnabled="False" />
                  <Button x:Name="ConnectionDisconnectButton" Content="Disconnect" Click="Disconnect_Click" IsEnabled="False" ToolTip="Stops live sync and removes the protected Dropbox credential. Pair definitions and recovery data are retained." />
                </StackPanel>
              </Grid>
            </Border>
            <TextBlock Margin="2,12,0,0" Text="Disconnecting never deletes pair definitions, synchronized content, baselines, or Recovery. Those pairs remain paused until the matching account is reconnected." Foreground="{DynamicResource MutedInk}" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Border x:Name="SettingsPage" Visibility="Collapsed">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel HorizontalAlignment="Stretch">
          <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="Choose how Sync Shark appears. System follows Windows; AMOLED uses black primary surfaces." Foreground="{DynamicResource MutedInk}" Margin="0,4,0,20" TextWrapping="Wrap" />
          <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="9" Padding="18">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <TextBlock Text="Appearance" FontSize="17" FontWeight="SemiBold" Grid.ColumnSpan="2" Margin="0,0,0,16" />
              <TextBlock Grid.Row="1" Text="Theme" VerticalAlignment="Center" /><StackPanel x:Name="ThemeChoices" Grid.Row="1" Grid.Column="1" Orientation="Horizontal" AutomationProperties.Name="Sync Shark theme"><RadioButton x:Name="SystemThemeChoice" Style="{StaticResource ThemeChoice}" Content="System" Tag="System" Checked="ThemeChoice_Checked" /><RadioButton x:Name="LightThemeChoice" Style="{StaticResource ThemeChoice}" Content="Light" Tag="Light" Checked="ThemeChoice_Checked" /><RadioButton x:Name="AmoledThemeChoice" Style="{StaticResource ThemeChoice}" Content="AMOLED black" Tag="AMOLED" Checked="ThemeChoice_Checked" /></StackPanel>
            </Grid>
          </Border>
          <TextBlock x:Name="ThemeStatus" Margin="2,12,0,20" Foreground="{DynamicResource MutedInk}" Text="Theme preference is stored with protected product state." />
          <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="9" Padding="18">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <TextBlock Text="Live Sync" FontSize="17" FontWeight="SemiBold" Grid.ColumnSpan="2" Margin="0,0,0,16" />
              <TextBlock Grid.Row="1" Text="All pairs" VerticalAlignment="Center" /><CheckBox x:Name="AutomationEnabledBox" Grid.Row="1" Grid.Column="1" Content="Live sync for enabled pairs" ToolTip="Turns live sync on or off for every enabled pair. Individual pairs can still be paused." AutomationProperties.Name="Live sync for all enabled pairs" />
              <TextBlock x:Name="AutomationIntervalLabel" Grid.Row="2" Text="Full safety check" VerticalAlignment="Center" Margin="0,10,0,0" /><StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0"><TextBox x:Name="AutomationIntervalBox" Text="15" Width="70" AutomationProperties.LabeledBy="{Binding ElementName=AutomationIntervalLabel}" /><TextBlock Text="minutes" Margin="8,0,0,0" VerticalAlignment="Center" /><TextBlock Text="Checks for changes that were not reported promptly" Foreground="{DynamicResource MutedInk}" Margin="16,0,0,0" VerticalAlignment="Center" /></StackPanel>
              <TextBlock Grid.Row="3" Text="Windows" VerticalAlignment="Center" Margin="0,10,0,0" /><CheckBox x:Name="StartWithWindowsBox" Grid.Row="3" Grid.Column="1" Content="Start Sync Shark with Windows in the notification area" Margin="0,10,0,0" AutomationProperties.Name="Start Sync Shark with Windows" />
              <Button Grid.Row="4" Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Save live sync" Click="SaveAutomation_Click" HorizontalAlignment="Left" Margin="0,16,0,0" />
            </Grid>
          </Border>
          <TextBlock x:Name="AutomationStatus" Margin="2,12,0,20" Foreground="{DynamicResource MutedInk}" Text="Live sync is off. Sync now remains available." TextWrapping="Wrap" />
          <Border x:Name="TransferSettingsPanel" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="9" Padding="18">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <TextBlock Text="Transfer controls" FontSize="17" FontWeight="SemiBold" Grid.ColumnSpan="2" Margin="0,0,0,16" />
              <TextBlock x:Name="ConcurrentPairsLabel" Grid.Row="1" Text="Concurrent pairs" VerticalAlignment="Center" /><TextBox x:Name="ConcurrentPairsBox" Grid.Row="1" Grid.Column="1" Text="2" Width="90" HorizontalAlignment="Left" ToolTip="Maximum number of pairs that may reconcile at the same time (1–8). File effects inside each pair remain durably ordered." AutomationProperties.LabeledBy="{Binding ElementName=ConcurrentPairsLabel}" />
              <TextBlock x:Name="UploadLimitLabel" Grid.Row="2" Text="Upload limit" VerticalAlignment="Center" Margin="0,10,0,0" /><StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0"><TextBox x:Name="UploadLimitBox" Text="0" Width="90" ToolTip="Upload bandwidth in KiB/s. Use 0 for unlimited." AutomationProperties.LabeledBy="{Binding ElementName=UploadLimitLabel}" /><TextBlock Text="KiB/s (0 = unlimited)" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedInk}" /></StackPanel>
              <TextBlock x:Name="DownloadLimitLabel" Grid.Row="3" Text="Download limit" VerticalAlignment="Center" Margin="0,10,0,0" /><StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0"><TextBox x:Name="DownloadLimitBox" Text="0" Width="90" ToolTip="Download bandwidth in KiB/s. Use 0 for unlimited." AutomationProperties.LabeledBy="{Binding ElementName=DownloadLimitLabel}" /><TextBlock Text="KiB/s (0 = unlimited)" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedInk}" /></StackPanel>
              <Button x:Name="SaveTransferSettingsButton" Grid.Row="4" Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Save transfer controls" Click="SaveTransferSettings_Click" HorizontalAlignment="Left" Margin="0,16,0,0" />
            </Grid>
          </Border>
          <TextBlock x:Name="TransferSettingsStatus" Margin="2,12,0,0" Foreground="{DynamicResource MutedInk}" Text="Two pairs may run concurrently; bandwidth is unlimited." TextWrapping="Wrap" />
        </StackPanel></ScrollViewer>
      </Border>
    </Grid>

    <!-- UI29 remainder: the one local Create Folder dialog. It owns no permanent form field, it only
         appears while the pair editor is open, and its Create action calls the same shared
         LocalFolderActions the CLI uses. -->
    <Border x:Name="CreateLocalFolderDialogHost" Grid.RowSpan="2" Grid.ColumnSpan="2" Panel.ZIndex="40" Visibility="Collapsed" Background="#99000000" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle" PreviewKeyDown="CreateLocalFolder_KeyDown">
      <Border Width="470" MaxWidth="620" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="22">
        <StackPanel>
          <TextBlock Text="Create folder" FontSize="19" FontWeight="SemiBold" />
          <TextBlock Text="The new folder is created inside the existing folder below. Nothing is ticked for sync, and no pair, account or sync state changes." Foreground="{DynamicResource MutedInk}" TextWrapping="Wrap" Margin="0,6,0,0" />
          <TextBlock x:Name="CreateLocalFolderParentText" Margin="0,12,0,0" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.Name="Folder that will contain the new folder" />
          <TextBlock x:Name="CreateLocalFolderNameLabel" Text="Folder name:" Margin="0,14,0,5" />
          <TextBox x:Name="CreateLocalFolderNameBox" MaxLength="255" AutomationProperties.LabeledBy="{Binding ElementName=CreateLocalFolderNameLabel}" />
          <TextBlock x:Name="CreateLocalFolderErrorText" Margin="0,8,0,0" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CreateLocalFolderCancelButton" Content="Cancel" Click="CreateLocalFolderCancel_Click" AutomationProperties.Name="Cancel the new folder" />
            <Button x:Name="CreateLocalFolderConfirmButton" Style="{StaticResource PrimaryButton}" Content="Create" Click="CreateLocalFolderConfirm_Click" Margin="10,0,0,0" AutomationProperties.Name="Create the new folder" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
