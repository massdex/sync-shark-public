<Window x:Class="Massdex.SyncShark.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Massdex.SyncShark"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Sync Shark" Icon="Assets/SyncShark.ico" Foreground="{DynamicResource Ink}" Width="1240" Height="790" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" SizeChanged="Window_SizeChanged">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="68" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <!-- The retained official Dropbox glyph is one flat brand blue (#0061FF). The theme token
         DropboxBlue stays #0061FE for general product chrome, so the mark carries the exact
         brand value on its own scoped brush instead of reusing that token. -->
    <SolidColorBrush x:Key="DropboxBrandBlue" Color="#FF0061FF" />
    <DataTemplate x:Key="FolderIconTemplate">
      <Viewbox Width="20" Height="18" Stretch="Uniform" VerticalAlignment="Center">
        <Canvas Width="24" Height="20">
          <Path Fill="{DynamicResource WarningBrush}" Data="M2,4 H9 L11,7 H22 V19 H2 Z" />
          <Path Fill="{DynamicResource WarningBrush}" Opacity="0.78" Data="M2,7 H22 V9 H2 Z" />
        </Canvas>
      </Viewbox>
    </DataTemplate>
    <!-- The four official blue glyph paths of the retained Dropbox SVG, unabridged and at their
         own coordinates: the mark only, with no wordmark. The canvas is that glyph's bounding
         box plus its own equal 0.4785 / 0.3203 margins, so proportions are unchanged. -->
    <DataTemplate x:Key="DropboxIconTemplate">
      <Viewbox Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center">
        <Canvas Width="29.8472" Height="25.1367">
          <Path Fill="{StaticResource DropboxBrandBlue}" Data="M7.70076 0.320312L0.478516 4.91332L7.70076 9.50633L14.9242 4.91332L22.1465 9.50633L29.3687 4.91332L22.1465 0.320312L14.9242 4.91332L7.70076 0.320312Z" />
          <Path Fill="{StaticResource DropboxBrandBlue}" Data="M7.70076 18.6925L0.478516 14.0994L7.70076 9.50633L14.9242 14.0994L7.70076 18.6925Z" />
          <Path Fill="{StaticResource DropboxBrandBlue}" Data="M14.9242 14.0994L22.1465 9.50633L29.3687 14.0994L22.1465 18.6925L14.9242 14.0994Z" />
          <Path Fill="{StaticResource DropboxBrandBlue}" Data="M14.9242 24.8164L7.70077 20.2234L14.9242 15.6304L22.1465 20.2234L14.9242 24.8164Z" />
        </Canvas>
      </Viewbox>
    </DataTemplate>
    <!-- The retained official Google Drive PNG keeps its full 128 px artwork as a WPF image
         resource and is scaled uniformly in place; no redraw and no rendering library. -->
    <DataTemplate x:Key="GoogleDriveIconTemplate">
      <Viewbox Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center">
        <Image Source="Assets/google-drive.png" Width="128" Height="128" Stretch="Uniform" />
      </Viewbox>
    </DataTemplate>
    <!-- U1: the neutral mark for the shared account picker's all-accounts entry and for any account
         whose provider identity is not known. No provider is claimed when none is known. -->
    <DataTemplate x:Key="NeutralAccountIconTemplate">
      <ui:CommandGlyph IconName="user" Width="18" Height="18" />
    </DataTemplate>
    <!-- One cloud-side mark for the pair editor and its trees: the account's own provider binding
         selects the artwork, so no surface assumes Dropbox when another provider is selected. -->
    <Style x:Key="CloudProviderMark" TargetType="ContentControl">
      <Setter Property="ui:ProviderMark.Provider" Value="{Binding ProviderPresentation.Key, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
    </Style>
    <Style x:Key="EndpointKindMarkHost" TargetType="ContentControl">
      <!-- UI354-ICON1: one shared endpoint-kind mark host. The host owns the size, so the authentic
           registered artwork can never inflate an intrinsic size into the layout. -->
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style x:Key="PairProviderButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="PairProviderChrome" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PairProviderChrome" Property="Background" Value="{DynamicResource HoverSurface}" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="PairProviderChrome" Property="BorderBrush" Value="{DynamicResource FocusBrush}" /><Setter TargetName="PairProviderChrome" Property="BorderThickness" Value="2" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.48" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid Background="{DynamicResource Canvas}">
    <Grid.RowDefinitions><RowDefinition Height="68" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="NavigationColumn" Width="196" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border x:Name="StartupLoadingHost" Grid.Row="1" Grid.Column="1" Panel.ZIndex="35" Background="{DynamicResource Canvas}" Padding="28">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="540">
        <Image Source="Assets/SyncShark-64.png" Width="48" Height="48" HorizontalAlignment="Left" Margin="0,0,0,18" />
        <TextBlock Text="Starting Sync Shark" FontSize="24" FontWeight="SemiBold" />
        <TextBlock x:Name="StartupLoadingText" Text="Loading saved accounts and folder pairs…" TextWrapping="Wrap" Margin="0,10,0,14" AutomationProperties.LiveSetting="Polite" />
        <ProgressBar x:Name="StartupLoadingProgress" IsIndeterminate="True" Height="4" />
        <Button x:Name="StartupRetryButton" Content="Retry loading" Click="MainWindow_Loaded" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,16,0,0" ToolTip="Read the saved app state again and safely reconcile any interrupted work. Completed effects are not repeated." />
        <Button x:Name="StartupRepairButton" Content="Repair interrupted setup" Click="StartupRepair_Click" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,8,0,0" ToolTip="Restore the last coherent published revision of the interrupted folder pair. Only saved setup metadata is rewritten; no file is transferred, moved or deleted, and nothing is approved or synced." />
        <TextBlock x:Name="StartupRepairStatus" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource MutedInk}" AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
    </Border>

    <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="HeaderBrandColumn" Width="196" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel x:Name="HeaderBrandPanel" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
          <Image x:Name="HeaderBrandIcon" Source="Assets/SyncShark-64.png" Width="42" Height="42" Margin="0,0,10,0" />
          <StackPanel x:Name="HeaderBrandText" VerticalAlignment="Center"><TextBlock Text="Sync Shark" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="by Massdex" FontSize="12" Foreground="{DynamicResource MutedInk}" /></StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0" Visibility="Collapsed">
          <Border Padding="11,6" CornerRadius="12" Background="{DynamicResource SelectedSurface}"><TextBlock x:Name="HeaderState" Text="Checking cloud account…" Foreground="{DynamicResource SelectedInk}" FontWeight="SemiBold" /></Border>
          <Button x:Name="HeaderAccountButton" Content="Checking account…" Click="HeaderAccount_Click" Margin="8,0,0,0" ToolTip="Open connection and account details" AutomationProperties.Name="Open storage connection details" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource CaptionButton}" Content="—" ToolTip="Minimize" Click="Minimize_Click" />
          <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="□" ToolTip="Maximize" Click="Maximize_Click" />
          <Button Style="{StaticResource CaptionButton}" Content="✕" ToolTip="Close" Click="Close_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <Border x:Name="NavigationBorder" Grid.Row="1" Grid.Column="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ListBox x:Name="Navigation" Grid.Row="0" Margin="10,14" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Navigation_SelectionChanged" SelectedIndex="0" AutomationProperties.Name="Sync Shark navigation">
          <ListBox.Resources>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="14,12" /><Setter Property="Margin" Value="0,3" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="FontSize" Value="14" />
              <Setter Property="Foreground" Value="{DynamicResource Ink}" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="3,0,0,0" />
              <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border CornerRadius="9" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" /></Border></ControlTemplate></Setter.Value></Setter>
              <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelectedSurface}" /><Setter Property="Foreground" Value="{DynamicResource FocusBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource HoverSurface}" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="FocusVisualStyle" Value="{x:Null}" /><Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" /></Trigger></Style.Triggers>
            </Style>
          </ListBox.Resources>
          <ListBoxItem Tag="Dashboard"><TextBlock Text="↻   Dashboard" /></ListBoxItem>
          <ListBoxItem Tag="Pairs"><TextBlock Text="⇄   Folder pairs" /></ListBoxItem>
          <ListBoxItem Tag="Connections"><TextBlock Text="◉   Connections" /></ListBoxItem>
          <ListBoxItem Tag="Bootstrap" Visibility="Collapsed"><TextBlock Text="✓   First sync" /></ListBoxItem>
          <ListBoxItem Tag="Activity"><TextBlock Text="◷   Activity" /></ListBoxItem>
          <ListBoxItem Tag="Queue" Visibility="Collapsed"><TextBlock Text="≡   Queue" /></ListBoxItem>
          <ListBoxItem Tag="Conflicts" Visibility="Collapsed"><TextBlock Text="△   Conflicts" /></ListBoxItem>
          <ListBoxItem Tag="Recovery"><TextBlock Text="↶   Recovery" /></ListBoxItem>
          <ListBoxItem Tag="Rewind" Visibility="Collapsed"><TextBlock Text="⟲   Dropbox Rewind" /></ListBoxItem>
          <ListBoxItem Tag="Settings"><TextBlock Text="⚙   Settings" /></ListBoxItem>
        </ListBox>
        <Button x:Name="SidebarToggle" Grid.Row="1" Margin="10,8,10,12" Height="40" Content="☰   Collapse sidebar" Click="SidebarToggle_Click" HorizontalContentAlignment="Center" ToolTip="Collapse sidebar" AutomationProperties.Name="Collapse sidebar" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" Grid.Column="1" Margin="20">
      <Border x:Name="DashboardPage" Background="Transparent">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" MinHeight="110" /><RowDefinition Height="220" /></Grid.RowDefinitions>
          <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Sync dashboard" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="Keep your selected folders in sync between this computer and your cloud accounts." FontSize="14" Foreground="{DynamicResource MutedInk}" Margin="0,4,0,0" TextWrapping="Wrap" /></StackPanel>
            <Button Grid.Column="1" x:Name="ConnectButton" Content="Checking connection…" Click="Connect_Click" IsEnabled="False" VerticalAlignment="Top" AutomationProperties.HelpText="Open the selected cloud account or connect an account when none is connected" />
          </Grid>

          <Border Grid.Row="1" Background="{DynamicResource RaisedSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,12">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="250" /></Grid.ColumnDefinitions>
              <Button Grid.Column="0" x:Name="RunButton" Style="{StaticResource PrimaryButton}" Content="Run sync" Click="Run_Click" />
              <Button Grid.Column="1" x:Name="PauseButton" Content="Pause sync" Click="Pause_Click" IsEnabled="False" ToolTip="Pause safely between transfers" />
              <Button Grid.Column="2" x:Name="StopButton" Content="Stop run" Click="Stop_Click" IsEnabled="False" />
              <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="8,0"><TextBlock x:Name="PhaseText" Text="Configure one pair and connect a cloud account." TextWrapping="Wrap" TextTrimming="None" /><ProgressBar x:Name="RunProgress" Height="7" Margin="0,6,0,0" /></StackPanel>
              <TextBox Grid.Column="4" x:Name="FilterBox" ToolTip="Filter visible run decisions" TextChanged="Filter_Changed" AutomationProperties.Name="Filter current run" />
            </Grid>
          </Border>

          <UniformGrid x:Name="CardsPanel" Grid.Row="2" Columns="6" Margin="0,0,0,12">
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="9" Padding="12,9" Margin="0,0,8,8"><StackPanel><TextBlock Text="Uploaded" FontSize="14" Foreground="{DynamicResource MutedInk}" /><TextBlock x:Name="UploadedCount" Text="Not measured" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="{Binding ProviderPresentation.CloudTargetLabel, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" FontSize="11" Foreground="{DynamicResource MutedInk}" /></StackPanel></Border>
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="9" Padding="12,9" Margin="0,0,8,8"><StackPanel><TextBlock Text="Downloaded" FontSize="14" Foreground="{DynamicResource MutedInk}" /><TextBlock x:Name="DownloadedCount" Text="Not measured" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="To this PC" FontSize="11" Foreground="{DynamicResource MutedInk}" /></StackPanel></Border>
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="9" Padding="12,9" Margin="0,0,8,8"><StackPanel><TextBlock Text="Identical" FontSize="14" Foreground="{DynamicResource MutedInk}" /><TextBlock x:Name="IdenticalCount" Text="Not measured" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="Already matched" FontSize="11" Foreground="{DynamicResource MutedInk}" /></StackPanel></Border>
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="9" Padding="12,9" Margin="0,0,8,8"><StackPanel><TextBlock Text="Conflicts" FontSize="14" Foreground="{DynamicResource MutedInk}" /><TextBlock x:Name="ConflictCount" Text="Not measured" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="Preserved unchanged" FontSize="11" Foreground="{DynamicResource MutedInk}" /></StackPanel></Border>
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="9" Padding="12,9" Margin="0,0,0,8"><StackPanel><TextBlock Text="Blocked" FontSize="14" Foreground="{DynamicResource MutedInk}" /><TextBlock x:Name="BlockedCount" Text="Not measured" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="Needs attention" FontSize="11" Foreground="{DynamicResource MutedInk}" /></StackPanel></Border>
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="9" Padding="12,9" Margin="0,0,0,8"><StackPanel><TextBlock Text="Pending" FontSize="14" Foreground="{DynamicResource MutedInk}" /><TextBlock x:Name="QueueCount" Text="0" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="Work still to finish" FontSize="11" Foreground="{DynamicResource MutedInk}" /></StackPanel></Border>
          </UniformGrid>

          <Grid Grid.Row="3">
            <DataGrid x:Name="ResultGrid" ItemsSource="{Binding VisibleRows}" AutoGenerateColumns="False" HorizontalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" PreviewMouseRightButtonDown="ResultGrid_PreviewMouseRightButtonDown" MouseDoubleClick="ResultGrid_MouseDoubleClick" AutomationProperties.Name="Current sync decisions">
              <DataGrid.ContextMenu><ContextMenu><MenuItem Header="Open details" Click="OpenDetails_Click" /><Separator /><MenuItem Header="Keep local; retain cloud version" Click="ResolveKeepLocal_Click" /><MenuItem Header="Keep cloud; retain local version" Click="ResolveKeepDropbox_Click" /><MenuItem Header="Preserve both versions" Click="ResolvePreserveBoth_Click" /><Separator /><MenuItem Header="Copy path" Click="CopyPath_Click" /><MenuItem Header="Copy technical details" Click="CopyTechnical_Click" /></ContextMenu></DataGrid.ContextMenu>
              <DataGrid.Columns><DataGridTextColumn Header="Connection" Binding="{Binding Connection}" Width="190" /><DataGridTextColumn Header="Pair" Binding="{Binding PairName}" Width="150" SortMemberPath="PairName" /><DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*" SortMemberPath="Path" /><DataGridTextColumn Header="Outcome" Binding="{Binding Outcome}" Width="130" SortMemberPath="Outcome" /><DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="2*" SortMemberPath="Reason" /></DataGrid.Columns>
            </DataGrid>
            <Border x:Name="EmptyResultsSurface" Margin="1,35,1,1" Background="{DynamicResource Surface}" IsHitTestVisible="False"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="430"><TextBlock Text="No run results yet" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock Text="Select a pair and run sync. Upload, download, identical, conflict, recovered and blocked outcomes will appear here." Foreground="{DynamicResource MutedInk}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" /></StackPanel></Border>
          </Grid>

          <TabControl Grid.Row="4" Margin="0,12,0,0">
            <TabItem Header="Summary"><TextBlock x:Name="SummaryText" Margin="12" Text="No sync has run in this session." TextWrapping="Wrap" /></TabItem>
            <TabItem Header="Details"><TextBox x:Name="DetailsText" Margin="8" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" /></TabItem>
            <TabItem Header="Technical"><TextBox x:Name="TechnicalText" Margin="8" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" /></TabItem>
            <TabItem Header="Live activity"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="What Sync Shark is doing now" FontWeight="SemiBold" /><Button Grid.Column="1" Content="Open full activity" Click="OpenActivity_Click" /></Grid><TextBox Grid.Row="1" x:Name="ConsoleText" Margin="0,8,0,0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" /></Grid></TabItem>
          </TabControl>
        </Grid>
      </Border>

      <Border x:Name="PairsPage" Visibility="Collapsed">
        <ScrollViewer x:Name="PairsScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" Focusable="False" ScrollChanged="PairsScroller_ScrollChanged">
          <StackPanel HorizontalAlignment="Stretch" Width="{Binding ViewportWidth, ElementName=PairsScroller, Mode=OneWay}">
            <Grid x:Name="PairsHeaderGrid" Margin="0,0,0,14">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <StackPanel><TextBlock Text="Folder Pairs" FontSize="24" FontWeight="SemiBold" ToolTip="Choose what stays in sync between this computer and your cloud accounts." AutomationProperties.HelpText="Choose what stays in sync between this computer and your cloud accounts." /></StackPanel>
              <WrapPanel x:Name="PairsHeaderActions" Grid.Column="1" VerticalAlignment="Top">
                <Grid x:Name="PairSearchHost" Width="220"><TextBox x:Name="PairSearchBox" Padding="31,7,9,7" TextChanged="PairSearch_Changed" AutomationProperties.Name="Search folder pairs" ToolTip="Search folder pairs by name or folder." /><TextBlock x:Name="PairSearchIcon" Text="⌕" FontSize="18" Foreground="{DynamicResource MutedInk}" Margin="10,0,0,1" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" /><TextBlock x:Name="PairSearchCue" Text="Search folder pairs…" Foreground="{DynamicResource MutedInk}" Margin="31,0,8,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=PairSearchBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
                <Button x:Name="AddPairButton" Content="＋ Add pair" Style="{StaticResource PrimaryButton}" Click="NewPair_Click" />
                <Button x:Name="SyncAllNowButton" Content="Sync all now" Click="RunAllPairsNow_Click"><Button.ToolTip><ToolTip><StackPanel><TextBlock Text="Sync all now" Foreground="{DynamicResource DropboxBlue}" FontWeight="SemiBold" /><TextBlock Text="Checks every live pair now and syncs any detected changes." TextWrapping="Wrap" /></StackPanel></ToolTip></Button.ToolTip></Button>
              </WrapPanel>
            </Grid>
            <TextBlock x:Name="PairPageActionFeedback" Visibility="Collapsed" Foreground="{DynamicResource MutedInk}" Margin="0,0,0,12" TextWrapping="Wrap" AutomationProperties.Name="Action status" />
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="9" Margin="0,0,0,12">
              <DockPanel LastChildFill="True">
                <ContentControl x:Name="NewPairEditorHost" DockPanel.Dock="Top" Visibility="Collapsed" Margin="8,8,8,0">
                  <Border x:Name="PairEditorPanel" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="9" Padding="16">
                    <Grid>
                      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                      <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel><TextBlock x:Name="PairEditorHeading" Text="Edit folder pair" FontSize="19" FontWeight="SemiBold" /><TextBlock Text="Choose the folders you want to keep in sync." FontSize="14" Foreground="{DynamicResource MutedInk}" Margin="0,3,12,0" TextWrapping="Wrap" /><Border x:Name="PairEditorStatus" Visibility="Collapsed" Background="{DynamicResource RaisedSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6" Padding="9,6" Margin="0,8,12,0"><TextBlock x:Name="PairEditorStatusText" Foreground="{DynamicResource MutedInk}" TextWrapping="Wrap" /></Border></StackPanel>
                        <WrapPanel x:Name="PairEditorActions" Grid.Column="1" HorizontalAlignment="Right"><Button x:Name="SavePairButton" Style="{StaticResource PrimaryButton}" Content="Save pair" Click="SavePair_Click" /><Button x:Name="CancelPairButton" Content="Cancel" Click="CancelPairEdit_Click" /><Button x:Name="EditorSyncNowButton" Content="Sync now" Click="RunPairNow_Click"><Button.ToolTip><ToolTip><StackPanel><TextBlock Text="Sync now" Foreground="{DynamicResource DropboxBlue}" FontWeight="SemiBold" /><TextBlock Text="Checks this pair now and syncs any detected changes." TextWrapping="Wrap" /></StackPanel></ToolTip></Button.ToolTip></Button></WrapPanel>
                      </Grid>
                      <Expander x:Name="PairIdentityDisclosure" Grid.Row="1" Header="Pair Details" Margin="0,0,0,10">
                      <Grid x:Name="PairIdentityGrid" Margin="0,10,0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition x:Name="PairNameColumn" Width="*" /><ColumnDefinition x:Name="SyncTypeColumn" Width="230" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel Margin="0,0,16,0"><TextBlock x:Name="PairNameLabel" Text="Pair Name" FontWeight="SemiBold" Margin="0,0,0,5" /><TextBox x:Name="PairNameBox" MaxLength="80" TextChanged="PairName_Changed" AutomationProperties.LabeledBy="{Binding ElementName=PairNameLabel}" /></StackPanel>
                        <StackPanel x:Name="SyncTypePanel" Grid.Column="1"><TextBlock Text="Connection" FontWeight="SemiBold" Margin="0,0,0,5" /><TextBlock x:Name="PairConnectionSummary" Text="Checking connection…" Padding="9,8" Background="{DynamicResource RaisedSurface}" /></StackPanel>
                      </Grid>
                      </Expander>
                      <TabControl x:Name="PairEditorTabs" Grid.Row="2" SelectionChanged="PairEditorTabs_SelectionChanged">
                        <TabItem Header="Folders">
                          <Grid Margin="12">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,10">
