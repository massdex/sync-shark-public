                        </TabItem>
                        <TabItem Header="Sync Settings">
                          <Grid Margin="14"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Text="Sync Type:" VerticalAlignment="Center" /><ComboBox x:Name="SyncTypeBox" Grid.Column="1" SelectedIndex="0" SelectionChanged="PairEditorSetting_Changed" Width="330" HorizontalAlignment="Left"><ComboBox.ToolTip><ToolTip><StackPanel><TextBlock Text="Sync Type:" Foreground="{DynamicResource DropboxBlue}" FontWeight="SemiBold" /><TextBlock Text="Choose whether changes sync in both directions or only one direction." TextWrapping="Wrap" /></StackPanel></ToolTip></ComboBox.ToolTip><ComboBoxItem Content="Two-Way" IsSelected="True" ToolTip="Changes made on this computer sync to the cloud. Changes made in the cloud sync to this computer." /><ComboBoxItem Content="Upload Only" ToolTip="Automatically copy local changes to the cloud. Cloud-only changes are not downloaded. Conflicting edits remain protected for review." /><ComboBoxItem Content="Download Only" ToolTip="Automatically copy cloud changes to this computer. Local-only changes are not uploaded. Conflicting edits remain protected for review." /></ComboBox>
                            <TextBlock Grid.Row="1" Text="Live Sync:" VerticalAlignment="Center" Margin="0,14,0,0" /><CheckBox x:Name="PairEnabledBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource PairToggle}" Content="Live sync" IsChecked="True" Checked="PairEnabled_Changed" Unchecked="PairEnabled_Changed" Margin="0,14,0,0" AutomationProperties.Name="Live sync"><CheckBox.ToolTip><ToolTip><StackPanel><TextBlock Text="Live Sync:" Foreground="{DynamicResource DropboxBlue}" FontWeight="SemiBold" /><TextBlock Text="Automatically syncs changes after Sync Shark detects them. Local changes are usually detected immediately. Cloud changes may take about 30 seconds." TextWrapping="Wrap" /></StackPanel></ToolTip></CheckBox.ToolTip></CheckBox>
                            <TextBlock Grid.Row="2" Text="Storage on This Computer:" VerticalAlignment="Center" Margin="0,14,0,0" /><StackPanel Grid.Row="2" Grid.Column="1" Margin="0,14,0,0"><ComboBox x:Name="PairStorageBox" Width="330" HorizontalAlignment="Left" SelectionChanged="PairStorage_Changed" AutomationProperties.Name="Storage on this computer"><ComboBoxItem Content="Available offline" IsSelected="True" ToolTip="Files are downloaded and kept on this computer so they can be opened without an internet connection." /><ComboBoxItem Content="Online-only" ToolTip="Files appear in File Explorer and download when opened, saving space on this computer." /></ComboBox><TextBlock x:Name="StorageSupportText" Foreground="{DynamicResource MutedInk}" Margin="0,5,0,0" TextWrapping="Wrap" /><CheckBox x:Name="PairFilesOnDemandBox" Visibility="Collapsed" AutomationProperties.Name="Stored online-only setting" /></StackPanel>
                            <TextBlock Grid.Row="3" Text="Sync Deletions:" VerticalAlignment="Center" Margin="0,14,0,0" />
                            <CheckBox x:Name="PairDeletionBox" Grid.Row="3" Grid.Column="1" Style="{StaticResource PairToggle}" Content="Apply deletions in both directions after saving a Recovery copy" Margin="0,14,0,0" Click="PairEditorSetting_Changed" AutomationProperties.Name="Sync Deletions" />
                            <TextBlock Grid.Row="4" Text="Sync Order:" VerticalAlignment="Center" Margin="0,14,0,0" /><ComboBox x:Name="PairPriorityChoice" Grid.Row="4" Grid.Column="1" Width="330" HorizontalAlignment="Left" Margin="0,14,0,0" SelectionChanged="PairPriorityChoice_Changed"><ComboBox.ToolTip><ToolTip><StackPanel><TextBlock Text="Sync Order:" Foreground="{DynamicResource DropboxBlue}" FontWeight="SemiBold" /><TextBlock Text="Controls which pair Sync Shark starts first when more than one pair is waiting to sync." TextWrapping="Wrap" /></StackPanel></ToolTip></ComboBox.ToolTip><ComboBoxItem Content="First" Tag="50" /><ComboBoxItem Content="Normal" Tag="0" IsSelected="True" /><ComboBoxItem Content="Last" Tag="-50" /></ComboBox><TextBox x:Name="PairPriorityBox" Grid.Row="4" Grid.Column="1" Text="0" Visibility="Collapsed" AutomationProperties.Name="Stored sync order value" />
                            <StackPanel x:Name="IgnoreRulesPanel" Grid.Row="5" Grid.ColumnSpan="2" Margin="0,24,0,0" />
                          </Grid>
                        </TabItem>
                        <TabItem Header="Sync Status">
                          <Grid Margin="14">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Border Background="{DynamicResource RaisedSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="7" Padding="14">
                              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PairHealthOverallText" Text="Checking…" FontSize="18" FontWeight="SemiBold" /><TextBlock x:Name="PairHealthReasonText" Text="Open this tab to see this pair's health." Foreground="{DynamicResource MutedInk}" Margin="0,5,18,0" TextWrapping="Wrap" MaxWidth="720" /></StackPanel><WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top"><Button Content="Choose different folders…" Click="ChangePairRoots_Click" /><Button Content="Check again" Click="CheckPairConnection_Click" /><Button x:Name="PairPauseButton" Content="Pause Pair" Click="PairPause_Click" Visibility="Collapsed" ToolTip="Pause this pair at its next safe checkpoint, or resume it without changing its enablement." /></WrapPanel></Grid>
                            </Border>
                            <Grid Grid.Row="1" Margin="0,12,0,0">
                              <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                              <TextBlock x:Name="PairHealthLocalTitle" Text="Left endpoint" FontWeight="SemiBold" TextWrapping="Wrap" />
                              <StackPanel Grid.Column="1" Margin="0,0,20,14">
                                <TextBlock Text="Status:" Foreground="{DynamicResource MutedInk}" FontSize="12" />
                                <TextBlock x:Name="PairHealthLocalText" Text="Checking…" TextWrapping="Wrap" />
                                <TextBlock Text="Folder location:" Foreground="{DynamicResource MutedInk}" FontSize="12" Margin="0,9,0,2" />
                                <Button Tag="local" Click="PairHealthPath_Click" HorizontalContentAlignment="Left" Padding="0" Margin="0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource DropboxBlue}" ToolTip="Open actions for this endpoint's exact folder."><TextBlock x:Name="PairHealthLocalPath" TextWrapping="Wrap" /></Button>
                              </StackPanel>
                              <TextBlock x:Name="PairHealthRemoteTitle" Grid.Column="2" Text="Right endpoint" FontWeight="SemiBold" TextWrapping="Wrap" />
                              <StackPanel Grid.Column="3" Margin="0,0,0,14">
                                <TextBlock Text="Status:" Foreground="{DynamicResource MutedInk}" FontSize="12" />
                                <TextBlock x:Name="PairHealthDropboxText" Text="Checking…" TextWrapping="Wrap" />
                                <TextBlock Text="Folder location:" Foreground="{DynamicResource MutedInk}" FontSize="12" Margin="0,9,0,2" />
                                <Button Tag="dropbox" Click="PairHealthPath_Click" HorizontalContentAlignment="Left" Padding="0" Margin="0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource DropboxBlue}" ToolTip="Open actions for this endpoint's exact folder."><TextBlock x:Name="PairHealthRemotePath" TextWrapping="Wrap" /></Button>
                              </StackPanel>
                              <TextBlock Grid.Row="1" Text="Live Sync:" FontWeight="SemiBold" /><TextBlock x:Name="PairHealthLiveSyncText" Grid.Row="1" Grid.Column="1" Text="Checking…" Margin="0,0,20,9" />
                              <TextBlock Grid.Row="1" Grid.Column="2" Text="Folder Monitor:" FontWeight="SemiBold" /><TextBlock x:Name="PairHealthMonitorText" Grid.Row="1" Grid.Column="3" Text="Checking…" Margin="0,0,0,9" />
                              <TextBlock Grid.Row="2" Text="First Sync:" FontWeight="SemiBold" /><TextBlock x:Name="PairHealthFirstSyncText" Grid.Row="2" Grid.Column="1" Text="Checking…" TextWrapping="Wrap" Margin="0,0,20,9" />
                              <TextBlock Grid.Row="2" Grid.Column="2" Text="Recovery:" FontWeight="SemiBold" /><TextBlock x:Name="PairHealthRecoveryText" Grid.Row="2" Grid.Column="3" Text="Checking…" TextWrapping="Wrap" Margin="0,0,0,9" />
                              <TextBlock Grid.Row="3" Text="Pending Changes:" FontWeight="SemiBold" /><TextBlock x:Name="PairHealthPendingText" Grid.Row="3" Grid.Column="1" Text="0" />
                              <TextBlock Grid.Row="3" Grid.Column="2" Text="Conflicts:" FontWeight="SemiBold" /><TextBlock x:Name="PairHealthConflictsText" Grid.Row="3" Grid.Column="3" Text="0" />
                            </Grid>
                            <StackPanel Grid.Row="2" Margin="0,16,0,0">
                              <TextBlock Text="Windows Explorer Ownership" FontWeight="SemiBold" />
                              <TextBlock x:Name="PairOwnershipText" Text="Not Checked" TextWrapping="Wrap" Margin="0,5,0,8" />
                              <WrapPanel x:Name="PairOwnershipActions" />
                            </StackPanel>
                            <TextBlock Grid.Row="3" Text="A pair that needs attention remains editable so you can repair its folder connection. Sync Shark will not sync that pair until its blocking problem is resolved." Foreground="{DynamicResource MutedInk}" TextWrapping="Wrap" Margin="0,12,0,0" />
                          </Grid>
                        </TabItem>
                        <TabItem Header="Advanced">
                          <StackPanel Margin="14">
                            <TextBlock Text="Recovery" FontSize="17" FontWeight="SemiBold" />
                            <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                              <TextBlock Text="Recovery Folder:" VerticalAlignment="Center" /><TextBox x:Name="RecoveryRootBox" Grid.Column="1" IsReadOnly="True" Margin="0,0,8,0" AutomationProperties.Name="Cloud Recovery folder"><TextBox.ToolTip><ToolTip><StackPanel><TextBlock Text="Recovery Folder:" Foreground="{DynamicResource DropboxBlue}" FontWeight="SemiBold" /><TextBlock Text="The cloud folder where Sync Shark saves restorable copies before replacing or deleting synced files and folders." TextWrapping="Wrap" /></StackPanel></ToolTip></TextBox.ToolTip></TextBox><StackPanel Grid.Column="2" Orientation="Horizontal"><Button Content="Use recommended" Click="UseRecommendedRecovery_Click" ToolTip="Use /Apps/Sync Shark/Recovery" /><Button x:Name="BrowseRecoveryButton" Content="Choose…" Click="BrowseRecovery_Click" /></StackPanel>
                              <TextBlock Grid.Row="1" Text="Protect Recovery Copies For:" VerticalAlignment="Center" Margin="0,10,0,0" /><ComboBox x:Name="RecoveryRetentionBox" Grid.Row="1" Grid.Column="1" Width="220" HorizontalAlignment="Left" Margin="0,10,0,0" SelectionChanged="PairEditorSetting_Changed" ToolTip="Sets how long recovery copies are protected from cleanup. Sync Shark never removes them without a warning and your confirmation."><ComboBoxItem Content="30 days minimum" Tag="30" /><ComboBoxItem Content="90 days minimum" Tag="90" IsSelected="True" /><ComboBoxItem Content="180 days minimum" Tag="180" /><ComboBoxItem Content="Until I remove them" Tag="Never" /></ComboBox>
                              <TextBlock Grid.Row="2" Text="Recovery Use:" VerticalAlignment="Center" Margin="0,10,0,0" /><StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0"><TextBlock x:Name="RecoveryUsageText" Text="Not loaded" Foreground="{DynamicResource MutedInk}" VerticalAlignment="Center" Margin="0,0,12,0" /><Button Content="Review cleanup…" Click="CleanupRecovery_Click" /></StackPanel>
                            </Grid>
                            <Separator Margin="0,16" />
                            <TextBlock Text="Troubleshooting" FontSize="17" FontWeight="SemiBold" />
                            <WrapPanel Margin="0,10,0,0"><Button Content="Check folder connection" Click="CheckPairConnection_Click"><Button.ToolTip><ToolTip><StackPanel><TextBlock Text="Check folder connection" Foreground="{DynamicResource DropboxBlue}" FontWeight="SemiBold" /><TextBlock Text="Checks that this pair still points to the same local and cloud folders. It does not scan or sync their contents." TextWrapping="Wrap" /></StackPanel></ToolTip></Button.ToolTip></Button><Button Content="Rescan folder structure" Click="RescanPairStructure_Click" ToolTip="Reloads folder names and selection status without syncing file contents." /></WrapPanel>
                            <Expander Header="Diagnostic Information" Margin="0,12,0,0"><Expander.ToolTip><ToolTip><StackPanel><TextBlock Text="Diagnostic Information" Foreground="{DynamicResource DropboxBlue}" FontWeight="SemiBold" /><TextBlock Text="Shows the pair ID and the saved identities of its local and cloud folders. Support may use these values to diagnose a connection problem." TextWrapping="Wrap" /></StackPanel></ToolTip></Expander.ToolTip><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock Text="{Binding ProviderPresentation.CloudFolderIdLabel, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" /><TextBlock x:Name="DropboxFolderIdText" Grid.Column="1" Text="Not selected" Foreground="{DynamicResource MutedInk}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Row="1" Text="Recovery Folder ID" Margin="0,8,0,0" /><TextBlock x:Name="RecoveryFolderIdText" Grid.Row="1" Grid.Column="1" Text="Not selected" Foreground="{DynamicResource MutedInk}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Row="2" Text="Connection" Margin="0,8,0,0" /><TextBlock x:Name="ConnectionText" Grid.Row="2" Grid.Column="1" Text="Checking cloud account…" Margin="0,8,0,0" /></Grid></Expander>
                            <Button x:Name="DisableFilesOnDemandButton" Content="Make every file available offline and turn off online-only storage…" Click="DisableFilesOnDemand_Click" HorizontalAlignment="Left" Margin="0,14,0,0" IsEnabled="False" />
                          </StackPanel>
                        </TabItem>
                        <TabItem Header="Storage">
                          <Grid x:Name="PairStorageTabHost" />
                        </TabItem>
                      </TabControl>
                    </Grid>
                  </Border>
                </ContentControl>
                <DataGrid x:Name="PairList" ItemsSource="{Binding PairRows}" AutoGenerateColumns="False" MinHeight="92" BorderThickness="0" RowHeight="68" SelectionMode="Single" SelectionChanged="PairList_SelectionChanged" PreviewMouseRightButtonDown="PairList_PreviewMouseRightButtonDown" MouseDoubleClick="PairList_MouseDoubleClick" HorizontalScrollBarVisibility="Auto" RowDetailsVisibilityMode="Collapsed" AutomationProperties.Name="Folder pairs">
                  <DataGrid.RowStyle><Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}"><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource RaisedSurface}" /><Setter Property="Foreground" Value="{DynamicResource Ink}" /><Setter Property="BorderBrush" Value="{DynamicResource DropboxBlue}" /><Setter Property="BorderThickness" Value="3,0,0,0" /></Trigger></Style.Triggers></Style></DataGrid.RowStyle>
                  <DataGrid.ContextMenu><ContextMenu><MenuItem x:Name="PairEditMenuItem" Header="Edit pair" Click="EditPair_Click" /><MenuItem x:Name="PairSyncNowMenuItem" Header="Sync now" Click="RunPairNow_Click" /><Separator /><MenuItem x:Name="PairDuplicateMenuItem" Header="Duplicate pair" Click="DuplicatePair_Click" /><MenuItem x:Name="PairDeleteMenuItem" Header="Delete pair…" Click="DeletePair_Click" /></ContextMenu></DataGrid.ContextMenu>
                  <DataGrid.RowDetailsTemplate><DataTemplate><ContentControl x:Name="PairRowDetailsHost" Loaded="PairRowDetailsHost_Loaded" Unloaded="PairRowDetailsHost_Unloaded" HorizontalAlignment="Left" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" Margin="0,6,0,12" /></DataTemplate></DataGrid.RowDetailsTemplate>
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Width="46"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Tag="{Binding}" Click="TogglePairEditor_Click" Style="{StaticResource PairProviderButton}" Width="28" Height="54" AutomationProperties.Name="{Binding Name, StringFormat=Expand or collapse {0}}" AutomationProperties.ItemStatus="{Binding ExpandedStateLabel}" AutomationProperties.HelpText="{Binding EndpointMarks.AccessibleName}" ToolTip="{Binding ExpandCollapseHint}"><ui:PairEndpointMark Presentation="{Binding EndpointMarks}" /></Button></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Pair" Width="170"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Connection}" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}" TextTrimming="CharacterEllipsis" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="This computer" Width="2*" MinWidth="175"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><ContentControl ContentTemplate="{StaticResource FolderIconTemplate}" Margin="0,0,9,0" /><TextBlock Text="{Binding LocalRoot}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTextColumn Header="Sync Type" Binding="{Binding SyncType}" Width="95" />
                    <DataGridTemplateColumn Width="1.6*" MinWidth="155"><DataGridTemplateColumn.HeaderTemplate><DataTemplate><TextBlock Text="{Binding ProviderPresentation.Name, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" /></DataTemplate></DataGridTemplateColumn.HeaderTemplate><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><ContentControl ui:ProviderMark.Provider="{Binding Provider}" /><TextBlock Text="{Binding DropboxRoot}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Sync Status" Width="220"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Click="OpenPairSyncStatus_Click" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left" HorizontalContentAlignment="Left" AutomationProperties.Name="Open pair sync status"><Button.ToolTip><ToolTip><StackPanel MaxWidth="360"><TextBlock Text="{Binding Status}" Foreground="{DynamicResource DropboxBlue}" FontWeight="SemiBold" /><TextBlock Text="{Binding StatusDetail}" TextWrapping="Wrap" /></StackPanel></ToolTip></Button.ToolTip><Border Padding="7,3" CornerRadius="9" HorizontalAlignment="Left" BorderThickness="1"><Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" /><Style.Triggers><DataTrigger Binding="{Binding Enabled}" Value="False"><Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" /></DataTrigger><DataTrigger Binding="{Binding GlobalLiveSyncEnabled}" Value="False"><Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" /></DataTrigger><DataTrigger Binding="{Binding NeedsAttention}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" /></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel MaxWidth="140"><TextBlock Text="{Binding Status}" FontWeight="SemiBold" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" /><Style.Triggers><DataTrigger Binding="{Binding Enabled}" Value="False"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></DataTrigger><DataTrigger Binding="{Binding GlobalLiveSyncEnabled}" Value="False"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></DataTrigger><DataTrigger Binding="{Binding NeedsAttention}" Value="True"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="{Binding StatusSummary}" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}" TextTrimming="CharacterEllipsis" /></StackPanel></Border></Button></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Live Sync" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox Style="{StaticResource PairToggle}" IsChecked="{Binding Enabled, Mode=OneWay}" IsEnabled="{Binding CanChangeLiveSync}" Content="{Binding LiveSyncLabel}" Tag="{Binding}" Click="PairLiveSync_Click" Loaded="PairLiveSync_Loaded" ToolTip="Turn automatic syncing on or off for this folder pair. Manual Sync now remains available." AutomationProperties.Name="Toggle live sync for this pair" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Border x:Name="BootstrapPage" Visibility="Collapsed">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <StackPanel Margin="0,0,0,12">
            <TextBlock Text="First sync review" FontSize="24" FontWeight="SemiBold" />
            <TextBlock x:Name="BootstrapSubtitle" Text="Review the current plan for this pair. One-sided items are copied to the missing side, identical items establish the baseline, and conflicts wait for your choice. Sync Shark checks both folders again before making changes." Foreground="{DynamicResource MutedInk}" Margin="0,4,0,0" TextWrapping="Wrap" />
            <TextBlock x:Name="BootstrapSummary" Text="Select a pair and run Sync now once to inventory both sides." Margin="0,8,0,0" TextWrapping="Wrap" />
            <TextBlock x:Name="BootstrapRetainedProblem" Text="" Foreground="{DynamicResource ErrorBrush}" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.Name="Retained first sync problem" />
            <Button x:Name="BootstrapRetainedProblemLink" Content="View the exact run" Click="OpenRetainedFirstSyncProblem_Click" HorizontalAlignment="Left" Margin="0,4,0,0" Visibility="Collapsed" ToolTip="Open the exact retained run and its completed actions in Activity." AutomationProperties.Name="View the exact first sync run" />
            <Button x:Name="RepairBootstrapMappingsButton" Content="Repair copied file mappings" Click="RepairBootstrapMappings_Click" HorizontalAlignment="Left" Margin="0,4,0,0" Visibility="Collapsed" ToolTip="Verify the completed copied-file history and current endpoint identities. Distinct files are preserved and separated in the new inventory; only verified obsolete move predecessors enter protected recovery. Uncertain operations are refused." AutomationProperties.Name="Repair copied file mappings" />
            <TextBlock x:Name="BootstrapEndpointSummary" Text="" Foreground="{DynamicResource MutedInk}" Margin="0,4,0,0" TextWrapping="Wrap" AutomationProperties.Name="First sync endpoints" />
          </StackPanel>
          <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="250" /><ColumnDefinition Width="230" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal"><TextBlock Text="Pair" VerticalAlignment="Center" Margin="0,0,6,0" /><ComboBox x:Name="BootstrapPairBox" Width="210" ItemsSource="{Binding PairRows}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="BootstrapPair_SelectionChanged" AutomationProperties.Name="First sync folder pair" /></StackPanel>
            <Button Grid.Column="1" x:Name="ApproveBootstrapButton" Style="{StaticResource PrimaryButton}" Content="Confirm choices and sync" Click="ApproveBootstrap_Click" IsEnabled="False"><Button.ToolTip><ToolTip><StackPanel MaxWidth="360"><TextBlock Text="Confirm choices and sync" Foreground="{DynamicResource DropboxBlue}" FontWeight="SemiBold" /><TextBlock Text="Confirms the complete reviewed choices and starts syncing. Each file is rechecked before copying; conflicting files are retained for resolution while independent safe files continue." TextWrapping="Wrap" /></StackPanel></ToolTip></Button.ToolTip></Button>
            <Button Grid.Column="2" x:Name="RefreshBootstrapButton" Content="Scan again" Click="RefreshBootstrap_Click" ToolTip="Checks both selected folders again and updates the first-sync plan without copying, replacing or deleting files." />
            <Grid Grid.Column="4"><TextBox x:Name="BootstrapSearchBox" Padding="31,7,9,7" TextChanged="BootstrapFilter_Changed" ToolTip="Search the complete first-sync inventory." AutomationProperties.Name="Search first-sync inventory" /><TextBlock Text="⌕" FontSize="18" Foreground="{DynamicResource MutedInk}" Margin="10,0,0,1" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" /><TextBlock Text="Search paths…" Foreground="{DynamicResource MutedInk}" Margin="31,0,8,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=BootstrapSearchBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
            <ComboBox Grid.Column="5" x:Name="BootstrapGroupFilter" SelectionChanged="BootstrapFilter_Changed">
              <ComboBoxItem Content="All groups" Tag="All groups" IsSelected="True" /><ComboBoxItem Content="Local newer" Tag="Local newer" /><ComboBoxItem Content="Cloud newer" Tag="Dropbox newer" /><ComboBoxItem Content="Approximately equal time" Tag="Approximately equal time" /><ComboBoxItem Content="Unreliable or missing time" Tag="Unreliable or missing time" /><ComboBoxItem Content="Identical" Tag="Identical" /><ComboBoxItem Content="Local only" Tag="Local only" /><ComboBoxItem Content="Cloud only" Tag="Dropbox only" /><ComboBoxItem Content="Changed locally since sync" Tag="Local changed since sync" /><ComboBoxItem Content="Changed remotely since sync" Tag="Dropbox changed since sync" /><ComboBoxItem Content="Unreliable or missing" Tag="Unreliable or missing" />
            </ComboBox>
            <WrapPanel Grid.Row="1" Grid.ColumnSpan="6" Margin="0,8,0,0">
              <Button Content="Edit folder choices" Click="OpenSelectiveFromBootstrap_Click" ToolTip="Open this pair at its selected folders, then return here to review the updated scope." />
              <Button Content="Review matching conflicts…" Click="ReviewBootstrapConflicts_Click" ToolTip="Open the conflicts that match the current group and search." />
              <ComboBox x:Name="BootstrapSelectedActionBox" Width="165" SelectedIndex="0" AutomationProperties.Name="Action for selected first-sync items" ToolTip="Choose what the selected items should do.">
                <ComboBoxItem Content="Recommended" Tag="Recommended" /><ComboBoxItem Content="Upload" Tag="Upload" /><ComboBoxItem Content="Download" Tag="Download" /><ComboBoxItem Content="Skip for now" Tag="Skip for now" />
              </ComboBox>
              <Button Content="Apply to selected" Click="ApplySelectedBootstrapAction_Click" ToolTip="Apply the chosen action only where it matches the item's current location." />
              <ComboBox x:Name="BootstrapMatchingActionBox" Width="165" SelectedIndex="0" AutomationProperties.Name="Action for every matching first-sync item" ToolTip="Choose what every item matching the current filters should do.">
                <ComboBoxItem Content="Recommended" Tag="Recommended" /><ComboBoxItem Content="Upload" Tag="Upload" /><ComboBoxItem Content="Download" Tag="Download" /><ComboBoxItem Content="Skip for now" Tag="Skip for now" />
              </ComboBox>
              <Button Content="Apply to all matching" Click="ApplyAllMatchingBootstrapAction_Click" ToolTip="Apply the chosen action to every matching item, including results not loaded on screen." />
              <Button x:Name="UseRecommendedBootstrapButton" Content="Use recommended choices" Click="UseRecommendedBootstrapChoices_Click" ToolTip="Set every displayed first-sync item to its recommended action. This is a draft choice: no files change until you confirm choices and sync." AutomationProperties.Name="Use recommended choices" />
              <ComboBox x:Name="BootstrapItemFilter" Width="118" SelectionChanged="BootstrapFilter_Changed" ToolTip="Show all items, folders only, or files only.">
