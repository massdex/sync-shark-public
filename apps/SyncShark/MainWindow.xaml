                                  <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}"><Setter Property="ToolTip" Value="{Binding State}" /></Style></DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                              </DataGrid.Columns>
                            </DataGrid>
